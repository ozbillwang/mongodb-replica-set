# MongoDB image tag, shared by all three members.
MONGO_VERSION=8.0

# Optional. Copy to .env before the FIRST start to use different ports.
# Published and advertised ports must match for host client discovery.
MONGO1_PORT=27017
MONGO2_PORT=27018
MONGO3_PORT=27019

# Publish on all IPv4 interfaces so containers can reach ports via the host gateway.
MONGO_BIND_IP=0.0.0.0

# Resolve host.docker.internal inside the MongoDB containers.
# host-gateway targets this Docker host; optionally use its reachable IP instead.
MONGO_HOST_IP=host-gateway
